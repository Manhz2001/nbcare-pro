# ==============================================================
# CẤU HÌNH VERTEX AGENT / GOOGLE GEMINI (THAY THẾ API KEY MEDCHECK)
# ==============================================================

# Cổng khởi chạy máy chủ (Mặc định: 8788)
PORT=8788

# 1. Cách 1: Sử dụng API Key của Google Gemini / Vertex AI Express Key (Đơn giản nhất)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model sử dụng (Mặc định: gemini-2.5-flash hoặc gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash

# 2. Cách 2: Sử dụng Google Cloud Project Vertex AI qua ADC (Tùy chọn)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
